{
  "baseUrl": "https://www.rma-engineering.com",
  "sitemapPath": "/sitemap.xml",
  "extraPaths": ["/inventors/thank-you", "/this-page-does-not-exist-404"],
  "excludePatterns": ["^/privacy-policy$"],
  "capPatterns": [{ "pattern": "^/blog/.+", "max": 3, "note": "newest posts by sitemap lastmod" }],
  "keyPages": ["/", "/contact-us", "/inventors", "/reality-check"],
  "expectedFont": "Inter",
  "viewports": {
    "desktop": { "width": 1440, "height": 900, "scale": 1, "mobile": false },
    "mobile":  { "width": 390,  "height": 844, "scale": 2, "mobile": true,
                 "userAgent": "Mozilla/5.0 (iPhone; CPU iPhone OS 17_0 like Mac OS X) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/17.0 Mobile/15E148 Safari/604.1" }
  },
  "composites": { "fullTopPx": 3000, "desktopFullWidth": 800, "mobileFullWidth": 400 },
  "thresholds": {
    "loadMsWarn": 3000,
    "lcpMsWarn": 2500,
    "diffPctWarn": 3,
    "sitewideChangeShare": 0.8,
    "heightChangeWarn": 0.10,
    "oversizeFactor": 2,
    "minWordsWarn": 120
  },
  "bannedPhrases": ["10+ years", "ten years", "over a decade", "decade of experience", "12 hours", "12-hour", "info@rma-engineering.com", "A+", "on staff", "engineers on staff", "under one roof", "our workshop", "own workshop", "contractor network", "our in-house", "engineers in-house", "engineers, in-house", "in-house engineers", "in-house prototyping", "in-house team", "in-house mechanical", "in-house design", "in-house fabrication", "built in-house", "build in-house", "prototypes in-house", "work in-house", "engineering in-house", "our in house", "engineers in house", "in house engineers", "in house prototyping", "in house team", "built in house", "our warehouse", "warehouse in New Jersey", "warehouse in North Jersey"],
  "allowPhrases": ["12-hour time zone"],
  "ctaPatterns": {
    "contact": "^/contact-us",
    "inventors": "^/inventors",
    "realityCheck": "^/reality-check",
    "booking": "hubspot\\.com/meetings|meetings\\.hubspot|calendar\\.app\\.google|calendly",
    "phone": "^tel:"
  },
  "ignoreAbortedRequests": [
    "^https://([^/]+\\.)?(google-analytics\\.com|googletagmanager\\.com|googleadservices\\.com|googlesyndication\\.com|doubleclick\\.net)/",
    "^https://([^/]+\\.)?google\\.com/(rmkt|ccm|pagead|g/collect)",
    "^https://(www\\.facebook\\.com/tr|connect\\.facebook\\.net/)",
    "^https://([^/]+\\.)?(hs-scripts\\.com|hs-analytics\\.net|hs-banner\\.com|hscollectedforms\\.net|hsadspixel\\.net)/|^https://track\\.hubspot\\.com/",
    "/_vercel/(insights|speed-insights)/",
    "[?&]_rsc="
  ],
  "ignoreFailedRequests": ["connect.facebook.net/log/error", "connect.facebook.net//log/error"],
  "linkCheck": { "enabled": true, "maxLinks": 400, "concurrency": 8 },
  "axe": { "enabled": true, "tags": ["wcag2a", "wcag2aa"], "sitewideShare": 0.5 }
}
